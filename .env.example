# ── NutriBot — Variáveis de Ambiente ─────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores.
# Nunca commite o .env com valores reais.

# ── IA ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# OpenAI — apenas Whisper (transcrição de áudio)
OPENAI_API_KEY=sk-proj-...
OPENAI_WHISPER_MODEL=whisper-1

# ── Banco de dados ────────────────────────────────────────────────────────────
# Local Docker: postgresql://nutribot:nutribot_dev@localhost:5432/nutribot
# VPS produção: postgresql://nutribot:<senha>@db:5432/nutribot
DATABASE_URL=postgresql://nutribot:nutribot_dev@localhost:5432/nutribot

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAF...
TELEGRAM_BOT_USERNAME=Minha_nutri_bot
# Obrigatório em produção — gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=

# ── WhatsApp Business (Meta Cloud API) — opcional ─────────────────────────────
# Phone Number ID: Meta for Developers → App → WhatsApp → Configuração
WHATSAPP_PHONE_NUMBER_ID=
# System User access token permanente: Meta Business Settings → System Users
WHATSAPP_ACCESS_TOKEN=
# App Secret: Meta for Developers → Configurações → Painel → App Secret
WHATSAPP_APP_SECRET=
# Token de verificação do webhook (você escolhe qualquer string segura):
# python -c "import secrets; print(secrets.token_hex(16))"
WHATSAPP_VERIFY_TOKEN=

# ── Mercado Pago — opcional ───────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MONTHLY_PLAN_ID=
MERCADOPAGO_ANNUAL_PLAN_ID=

# ── Segurança ─────────────────────────────────────────────────────────────────
# Criptografia dos dados de saúde em repouso (LGPD Art. 11) — 64 hex chars:
# python -c "import secrets; print(secrets.token_hex(32))"
RAW_INPUT_ENCRYPTION_KEY=

# JWT — 32+ chars:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Protege /scheduler/trigger e /scheduler/status
ADMIN_API_KEY=

# Senha do painel /admin — obrigatória em produção
ADMIN_PASSWORD=

# ── Analytics / Monitoramento — opcional ──────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=production
# URL pública do app (usada em links do bot Telegram)
# Ex: https://app.seudominio.com
APP_URL=https://app.seudominio.com
LOG_LEVEL=INFO
MAINTENANCE_MODE=false
DEFAULT_TIMEZONE=America/Sao_Paulo

# Open beta de relatórios — true=todos os usuários têm acesso
REPORTS_OPEN_BETA=true
