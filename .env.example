# ── IA ───────────────────────────────────────────────────────────────────────
# Anthropic (Claude) — NLP, Vision, sugestões do relatório
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# OpenAI — apenas Whisper (transcrição de áudio)
OPENAI_API_KEY=sk-proj-...
OPENAI_WHISPER_MODEL=whisper-1

# ── Banco de dados ────────────────────────────────────────────────────────────
# Railway PostgreSQL: copie a URL da aba "Variables" do serviço PostgreSQL
# Supabase: Settings > Database > Connection string (mode: URI)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAF...
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=seu_secret_hex_aqui

# ── WhatsApp (Evolution API) — opcional no beta ──────────────────────────────
# Siga docs/whatsapp-evolution-setup.md para configurar
EVOLUTION_API_URL=https://evolution-api.onrender.com
EVOLUTION_API_INSTANCE=nutribot
EVOLUTION_API_KEY=seu_api_key_aqui
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
EVOLUTION_WEBHOOK_SECRET=

# ── Mercado Pago — opcional no beta ──────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MONTHLY_PLAN_ID=
MERCADOPAGO_ANNUAL_PLAN_ID=

# ── Segurança ─────────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção — gere com: python -c "import secrets; print(secrets.token_hex(32))"
RAW_INPUT_ENCRYPTION_KEY=seu_hex_64_chars_aqui

# ── Analytics ─────────────────────────────────────────────────────────────────
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# ── Monitoramento ─────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=production
# URL pública do serviço (usada em links do bot Telegram). Igual ao WEBHOOK_BASE_URL se não definido.
APP_URL=https://nutri-bot-ot0p.onrender.com
LOG_LEVEL=INFO
MAINTENANCE_MODE=false
DEFAULT_TIMEZONE=America/Sao_Paulo
